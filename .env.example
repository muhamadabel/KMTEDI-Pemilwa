# Set these in Vercel > Project > Settings > Environment Variables.
# Never commit real values.

# Browser-safe (dikirim ke browser lewat build.js)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only (hanya dipakai di /api, JANGAN pernah ke frontend)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_OR_SECRET_KEY
SMTP_USER=panitia@gmail.com
SMTP_PASS=GOOGLE_APP_PASSWORD
# Random 32+ byte string, contoh: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=CHANGE_ME

# Opsional: origin tambahan yang boleh memanggil /api (pisahkan koma)
ALLOWED_ORIGINS=
